NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# HMRC Developer Hub sandbox app credentials.
# Register an app at https://developer.service.hmrc.gov.uk/ and put it in the SANDBOX environment.
HMRC_API_BASE=https://test-api.service.hmrc.gov.uk
HMRC_LOGIN_BASE=https://test-www.tax.service.gov.uk
HMRC_CLIENT_ID=your_hmrc_sandbox_client_id
HMRC_CLIENT_SECRET=your_hmrc_sandbox_client_secret

# Where HMRC redirects the user after they log in. Must match the redirect URI
# registered on the Developer Hub app (one per environment).
HMRC_REDIRECT_URI=http://localhost:3000/api/hmrc/auth/callback

# Space-delimited OAuth scopes requested at login.
#  - hello                     · Phase 1/2 probes against /hello/*
#  - write:self-assessment     · Phase 3a MTD-IT periodic summary submission
#  - read:vat write:vat        · Phase 3b MTD-VAT return submission
# Whenever this list changes, users must disconnect & reconnect to grant new scopes.
HMRC_SCOPES=hello write:self-assessment read:vat write:vat

# 32-byte random key, base64-encoded. Used to AES-256-GCM encrypt the HMRC
# tokens stored in the HttpOnly cookie. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HMRC_COOKIE_SECRET=replace_with_a_base64_encoded_32_byte_random_key

# Optional. The public IP of the server making calls to HMRC, used to populate
# Gov-Vendor-Public-IP and the `by=` part of Gov-Vendor-Forwarded. HMRC's
# sandbox is lenient if this is omitted; in production they are stricter.
HMRC_VENDOR_PUBLIC_IP=

# Optional (default 1). How many reverse proxies sit between the public
# internet and this app. Used to pick the caller's real IP out of
# X-Forwarded-For for Gov-Client-Public-IP: we count in from the RIGHT by this
# many hops, because entries to the left of our own proxies are supplied by the
# caller and can be forged. Vercel's edge is exactly one hop. Raise this only if
# you put another CDN or load balancer in front — setting it too HIGH makes us
# fall back to x-real-ip; too LOW lets a caller spoof the IP we report to HMRC.
HMRC_TRUSTED_PROXY_HOPS=1

# Optional. HMRC's "Manage authorised applications" service — where a user
# actually withdraws the authority granted to this app. HMRC publishes no
# programmatic token-revocation endpoint, so /api/hmrc/auth/disconnect clears
# our own token cookie and points the user here. Defaults to the production
# service; for sandbox use the test host that matches HMRC_LOGIN_BASE:
#   https://test-www.tax.service.gov.uk/applications-manage-authority
HMRC_MANAGE_AUTHORITY_URL=

# Optional. Overrides the endpoint used by the live fraud-header validation
# spec (src/lib/hmrc/__tests__/fraud-headers.sandbox.test.ts). Set this if
# HMRC's Test Fraud Prevention Headers API moves. Run that spec with:
#   node --env-file=.env.local ./node_modules/.bin/vitest run fraud-headers.sandbox
HMRC_FPH_VALIDATOR_URL=
